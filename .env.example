# ============================================================
# Sales AI OS - 環境変数テンプレート
#
# 使い方（新しいPCでのセットアップ）:
#   1. cp .env.example .env.local
#   2. 各値を埋める（実際の値は既存PCの .env.local から安全な手段で移す）
#   3. npm install && npm run dev
#
# ⚠️ このファイルに実際のキーを書かないこと。Git管理下にあります。
# ============================================================

# --- Supabase（必須）------------------------------------------
# Supabase ダッシュボード > Project Settings > API から取得
# Project ID: kaqhjlmftxvjjbmcuoyq
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role キー。RLSを迂回するため取り扱い注意（サーバー側・スクリプト専用）
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic（任意）-----------------------------------------
# 文面生成はテンプレート方式がデフォルトのため、通常は不要。
# AI生成を使う場合のみ設定する。
ANTHROPIC_API_KEY=
# 'true' のときだけUIにAI生成が出る。未設定/false ならテンプレート生成のみ。
NEXT_PUBLIC_ENABLE_AI_GENERATION=false
# Anthropic Managed Agent を使う場合のみ。未設定なら実行時に自動作成される。
MANAGED_AGENT_ID=
MANAGED_ENVIRONMENT_ID=

# --- Google Places（リスト収集に必要）--------------------------
# npm run fetch:prospects で見込み顧客を収集する際に使用
GOOGLE_PLACES_API_KEY=

# --- Resend（メール送信に必要）--------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- 運用 ------------------------------------------------------
# スクリプト実行時の既定ユーザーID（--user-id 省略時に使われる）
# 例: npm run enrich:prospects
OWNER_USER_ID=

# 在庫ページ(/api/inventory)のPIN認証用
INVENTORY_PIN=
